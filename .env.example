# ─── Server ────────────────────────────────────────────────
APP_ENV=local            # local | prod
HTTP_PORT=8080
LOG_LEVEL=debug          # debug | info | warn | error
SHUTDOWN_TIMEOUT=10s

# ─── PostgreSQL ────────────────────────────────────────────
# Matches docker-compose.yml defaults
DATABASE_URL=postgres://tradenexus:tradenexus@localhost:5432/tradenexus?sslmode=disable
PG_MAX_CONNS=10
PG_MIN_CONNS=2

# ─── Redis ─────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Angel One SmartAPI (used from Module 2 onward) ────────
# Fill these in when we wire the Angel client. Not required to boot Module 1.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# ─── Angel rate limits (token bucket) ──────────────────────
# Angel's historical endpoint is the tightest bucket. Keep these conservative.
# rate = sustained requests/sec, burst = max short spike.
ANGEL_HIST_RATE=2
ANGEL_HIST_BURST=2
# The scrip master is a large remote JSON file; slow networks may need more time.
ANGEL_SCRIPMASTER_TIMEOUT=5m
ANGEL_SCRIPMASTER_ATTEMPTS=3
# Optional override for local testing or if Angel changes the file host.
ANGEL_SCRIPMASTER_URL=

# ─── Auth ──────────────────────────────────────────────────
# CHANGE THIS in any real deployment.
JWT_SECRET=dev-change-me-please

# Admin account. If both are set, this account is (re)created on every boot with
# is_admin=true — it's the only login that can see the Admin > Candle tools page
# (inspect / delete / refetch a specific day). Leave blank to disable admin tools.
ADMIN_EMAIL=admin@tradenexus.local
ADMIN_PASSWORD=1234567890

# ─── Scanner / scheduler (Module 6) ────────────────────────
EXCHANGE=NSE
SCHEDULER_ENABLED=true
# Cron is IST. Daily post-close scan (Mon-Fri) + nightly cleanup.
DAILY_SCAN_CRON=0 16 * * 1-5
CLEANUP_CRON=0 1 * * *
# Fill SCHEDULED paper trades at market open (09:16 IST, Mon-Fri).
FILL_SCHEDULED_CRON=16 9 * * 1-5
RETENTION_DAYS=30
RECONCILE_ON_STARTUP=true
# Grace period (minutes) after the 15:30 IST close before a daily candle is
# treated as finalized (Angel's EOD data can lag the bell). Today's candle is
# never persisted until now >= 15:30 + this buffer.
MARKET_CLOSE_BUFFER_MIN=15

# Intraday cache: while the market is open, cache today's forming candle for all
# tracked stocks in Redis and refresh every INTRADAY_CACHE_INTERVAL. Manual scans
# then use this + Postgres history (no per-scan Angel hammering).
INTRADAY_CACHE_ENABLED=true
INTRADAY_CACHE_INTERVAL=20m

# ─── Notifications (Module 7) ──────────────────────────────
NOTIFY_ENABLED=true
# Only signals whose candle date is within this many days are sent (older are
# stored in the audit log but not dispatched). Retention cleanup is separate (30d).
NOTIFY_WINDOW_DAYS=7

TELEGRAM_DEFAULT_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# If the default chat above is a forum supergroup, these route each signal
# category to its own topic instead of General. 0 or blank = General topic.
TELEGRAM_STOCK_SIGNALS_THREAD_ID=
TELEGRAM_IPO_ALERTS_THREAD_ID=
TELEGRAM_PROMOTER_THREAD_ID=
TELEGRAM_BULK_DEALS_THREAD_ID=
TELEGRAM_BLOCK_DEALS_THREAD_ID=

# Bulk & block deals tracker (NSE historical bulk-block CSV feed).
DEALS_ENABLED=true
DEALS_RETENTION_DAYS=30
DEALS_ALERT_WINDOW_DAYS=7
DEALS_ALERT_CRON=0 19 * * *
# Bulk-deal churn filter: net value (₹) a client must clear to count. ₹5cr.
BULK_DEAL_MIN_NET_VALUE=50000000