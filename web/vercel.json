{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/((?!v1/).*)",
            "destination": "/index.html",
            "has": [
                {
                    "type": "header",
                    "key": "x-vercel-rewritten",
                    "value": "(?<value>.*)"
                }
            ]
        }
    ]
}